# data/client.py's DataClient - sent as `Authorization: Bearer <key>` on every request.
# Defaults to https://api.massive.com/; pass a different base_url to DataClient for
# other sources.
MASSIVE_API_KEY=

# Minimum seconds between requests sent by one DataClient instance (see _pace) - keeps
# paged jobs (sync_tickers, a multi-page sync_bars fetch) from outrunning massive.com's
# rate limiter. Defaults to 0.1 (10 req/s) if unset. No published quota to tune this
# against, so treat this as a guess until massive.com's support confirms the real one.
MASSIVE_MIN_REQUEST_INTERVAL_SECONDS=

# jobs/sync_bars.py's/sync_snapshots.py's/sync_ticker_details.py's/sync_indicators.py's
# ThreadPoolExecutor size - each worker opens its own DataClient per ticker, so this
# compounds with MASSIVE_MIN_REQUEST_INTERVAL_SECONDS above rather than being throttled
# by it (N workers means up to N near-simultaneous first requests no matter how that's
# set). Defaults to 8 if unset - lower it if 429s persist even after tightening the
# per-client pacing.
MASSIVE_MAX_WORKERS=

# backend-v2's own database - separate from v1's DATABASE_URL at the repo root, since
# v2 is not sharing v1's db. Defaults to sqlite:///./backend_v2.db if unset.
BACKEND_V2_DATABASE_URL=

# app/main.py's FastAPI app (job endpoints, CORS) + scheduler, launched via run_jobs.py.
# Distinct from v1's BACKEND_PORT (8000) so both can run side by side.
BACKEND_V2_HOST=127.0.0.1
BACKEND_V2_PORT=8001

# Comma-separated origins app/main.py accepts dashboard requests from (CORS) - no
# default on purpose, see app/main.py. frontend-v2's Vite dev server defaults to 5174.
CORS_ORIGINS=http://localhost:5174

# jobs/sync_bars.py's defaults (OHLC Custom Bars, GET /v2/aggs/ticker/.../range/...).
# run_bars_manual.py (ad hoc backfills) takes these as CLI flags instead. The nightly
# job's own settings - schedule, ticker_types/tickers filter, multiplier, timespan,
# backfill_days - live in the job_configs table instead, editable from the dashboard's
# Jobs page (see app/main.py); these env vars only seed that row's initial values the
# first time it's created (a fresh database, or before the dashboard's ever touched it).
# How far back to backfill a ticker that has never been synced. Defaults to 730 (2 years).
BARS_DEFAULT_BACKFILL_DAYS=
