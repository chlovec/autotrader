# data/client.py's DataClient - sent as `Authorization: Bearer <key>` on every request.
# Defaults to https://api.massive.com/; pass a different base_url to DataClient for
# other sources.
MASSIVE_API_KEY=

# backend-v2's own database - separate from v1's DATABASE_URL at the repo root, since
# v2 is not sharing v1's db. Defaults to sqlite:///./backend_v2.db if unset.
BACKEND_V2_DATABASE_URL=

# jobs/sync_bars.py (OHLC Custom Bars, GET /v2/aggs/ticker/.../range/...). Only read by
# the nightly job (run_jobs.py) - run_bars_manual.py takes these as CLI flags instead.
# How far back to backfill a ticker that has never been synced. Defaults to 730 (2 years).
BARS_DEFAULT_BACKFILL_DAYS=
# Bar granularity for the nightly job. Default multiplier=1, timespan=day.
BARS_MULTIPLIER=
BARS_TIMESPAN=
# Optional filters for the nightly job - comma-separated, mutually exclusive, e.g.
# BARS_NIGHTLY_TICKER_TYPES=CS,ETF or BARS_NIGHTLY_TICKERS=AAPL,MSFT. Leave both blank
# to sync every ticker in the tickers table.
BARS_NIGHTLY_TICKER_TYPES=
BARS_NIGHTLY_TICKERS=
