# Which broker to trade through: "alpaca", "ibkr", or "questrade" - see
# engine/brokers/__init__.py. Only the config block below matching this value is
# actually read; the others are ignored.
BROKER=alpaca

# --- alpaca ---
# Paper credentials from https://app.alpaca.markets/paper/dashboard/overview.
# Only used for trading when BROKER=alpaca, but run_research.py's news layer always
# uses these (Alpaca's News API) regardless of BROKER - set a free paper key pair
# here even if you trade through IBKR/Questrade.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Live credentials from https://app.alpaca.markets (a separate account from the
# paper one, requires funding/verification) - only used when ALPACA_PAPER=false.
# Keeping both pairs here lets `make run-alpaca-sim` / `make run-alpaca-live`
# switch modes without editing this file each time - see README.md "Going live".
ALPACA_LIVE_API_KEY=
ALPACA_LIVE_SECRET_KEY=

# Set to false only when deliberately trading live - see README.md "Going live"
ALPACA_PAPER=true

# --- ibkr (only read when BROKER=ibkr) ---
# Requires Trader Workstation (TWS) or IB Gateway running locally with API access
# enabled (File > Global Configuration > API > Settings > "Enable ActiveX and
# Socket Clients"; leave "Read-Only API" unchecked so orders can be submitted).
# No API key - you authenticate by logging into TWS/Gateway itself.
# Default port 7497 = TWS paper trading. Others: 7496 TWS live, 4002 Gateway
# paper, 4001 Gateway live.
IBKR_HOST=127.0.0.1
IBKR_PORT=7497
IBKR_CLIENT_ID=1

# --- questrade (only read when BROKER=questrade) ---
# Get a refresh token from https://login.questrade.com/APIAccess/UserApps.aspx
# (use the practice portal instead for a simulated/practice account - same API,
# separate token). This token is only used once - Questrade issues a new one on
# every refresh, which this app stores in questrade_token.json (gitignored). If
# that file exists, it takes precedence over this value.
QUESTRADE_REFRESH_TOKEN=

# Database shared by the engine and the FastAPI backend
DATABASE_URL=sqlite:///./autotrader.db

# Risk limits enforced by engine/risk.py
MAX_POSITION_SIZE_USD=1000
MAX_DAILY_LOSS_USD=200

# Backend API
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Email alerts (optional). Leave blank to skip email - macOS notifications always fire
# regardless. Gmail example: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_PASSWORD=an
# app password (not your regular password).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
