# Multi-account: every account this deployment trades is listed here, then configured via
# its own ACCOUNT_<id>_* block below. Account ids are arbitrary slugs (letters/digits/underscore)
# - they show up in the dashboard URL (/accounts/<id>) and in the ACCOUNT_<id>_* var names, so
# pick something readable.
ACCOUNT_IDS=alpaca_paper

# --- account: alpaca_paper ---
# Which broker this account trades through: "alpaca", "ibkr", or "questrade" - only the
# block matching this value is actually read for this account.
ACCOUNT_alpaca_paper_BROKER=alpaca
# Shown on the dashboard - defaults to the account id above if omitted.
ACCOUNT_alpaca_paper_DISPLAY_NAME=Alpaca Paper

# -- alpaca fields (only read when this account's BROKER=alpaca) --
# Paper credentials from https://app.alpaca.markets/paper/dashboard/overview.
ACCOUNT_alpaca_paper_ALPACA_API_KEY=
ACCOUNT_alpaca_paper_ALPACA_SECRET_KEY=
ACCOUNT_alpaca_paper_ALPACA_BASE_URL=https://paper-api.alpaca.markets
# Live credentials from https://app.alpaca.markets (a separate account from the paper one,
# requires funding/verification) - only used when this account's ALPACA_PAPER=false.
ACCOUNT_alpaca_paper_ALPACA_LIVE_API_KEY=
ACCOUNT_alpaca_paper_ALPACA_LIVE_SECRET_KEY=
ACCOUNT_alpaca_paper_ALPACA_LIVE_BASE_URL=https://api.alpaca.markets
# Set to false only when deliberately trading live - see README.md "Going live"
ACCOUNT_alpaca_paper_ALPACA_PAPER=true

# -- ibkr fields (only read when this account's BROKER=ibkr) --
# Requires Trader Workstation (TWS) or IB Gateway running locally with API access enabled
# (File > Global Configuration > API > Settings > "Enable ActiveX and Socket Clients"; leave
# "Read-Only API" unchecked so orders can be submitted). No API key - you authenticate by
# logging into TWS/Gateway itself. Default port 7497 = TWS paper trading. Others: 7496 TWS
# live, 4002 Gateway paper, 4001 Gateway live. IBKR_CLIENT_ID must be unique per account
# connecting to the same TWS/Gateway instance.
ACCOUNT_alpaca_paper_IBKR_HOST=127.0.0.1
ACCOUNT_alpaca_paper_IBKR_PORT=7497
ACCOUNT_alpaca_paper_IBKR_CLIENT_ID=1

# -- questrade fields (only read when this account's BROKER=questrade) --
# Get a refresh token from https://login.questrade.com/APIAccess/UserApps.aspx (use the
# practice portal instead for a simulated/practice account - same API, separate token). This
# token is only used once - Questrade issues a new one on every refresh, which this app
# stores in questrade_token_<account id>.json (gitignored). If that file exists, it takes
# precedence over this value.
ACCOUNT_alpaca_paper_QUESTRADE_REFRESH_TOKEN=
# Questrade has no push/webhook API, so its BrokerClient.stream() simulates one by polling on
# this interval.
ACCOUNT_alpaca_paper_QUESTRADE_POLL_INTERVAL_SECONDS=5

# -- per-account trading strategy (only read the first time this account id is seen - after
# that it's owned by the dashboard, edits here are ignored) --
# One of: ma_crossover, mean_reversion, regime_switching, rebalancing_portfolio
ACCOUNT_alpaca_paper_STRATEGY=rebalancing_portfolio
# JSON. rebalancing_portfolio takes {"target_weights": {...}} (must sum to 1.0); the three
# Strategy subclasses take their constructor kwargs, e.g. {"short_window": 20, "long_window": 50}
# for ma_crossover, or {} for defaults.
ACCOUNT_alpaca_paper_STRATEGY_PARAMS={"target_weights": {"SPY": 0.3333, "TLT": 0.3333, "GLD": 0.3334}}

# --- add more accounts by repeating the ACCOUNT_<id>_* block above under a new id, then ---
# --- adding that id to ACCOUNT_IDS. ---

# Database shared by the engine and the FastAPI backend
DATABASE_URL=sqlite:///./autotrader.db

# Default max position size / max daily loss / max total exposure (USD), seeded onto a
# newly-discovered account the first time its id appears in ACCOUNT_IDS - after that, edit
# limits from the account's dashboard page instead, not here.
MAX_POSITION_SIZE_USD=1000
MAX_DAILY_LOSS_USD=200
# Caps total open-position value across every symbol at once (as opposed to
# MAX_POSITION_SIZE_USD, which caps one symbol) - blocks new buys once hit, sells always
# still free up room. 0 = no cap (the default - opt in per account from the dashboard).
MAX_TOTAL_EXPOSURE_USD=0

# Research (engine/research.py) always screens using Alpaca's News API, independent of which
# broker(s) any account actually trades through - set a free Alpaca paper key pair here even
# if no account trades through Alpaca at all.
ALPACA_NEWS_API_KEY=
ALPACA_NEWS_SECRET_KEY=

# Backend API
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Comma-separated origins the backend accepts dashboard requests from (CORS).
# Required - the backend refuses to start without this set. Local dev with the
# default Vite port: http://localhost:5173. In production, set this to wherever
# the built dashboard is actually served from (see README.md "Deploying"), not
# localhost.
CORS_ORIGINS=http://localhost:5173

# Email alerts (optional). Leave blank to skip email - macOS notifications always fire
# regardless. Gmail example: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_PASSWORD=an
# app password (not your regular password).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
